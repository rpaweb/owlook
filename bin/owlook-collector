#!/usr/bin/env ruby
# frozen_string_literal: true

# The collector: one long-lived process, all projects, all sources. This is
# what the systemd --user unit runs.

# Self-activates its own Gemfile so systemd can invoke this with a bare ruby
# path (never a mise shim) and no `bundle exec` wrapper in ExecStart=.
gemfile = File.expand_path("../Gemfile", __dir__)
if File.exist?(gemfile)
  ENV["BUNDLE_GEMFILE"] ||= gemfile
  require "bundler/setup"
end

require_relative "../lib/owlook"

CONFIG_PATH = File.expand_path(ENV.fetch("OWLOOK_CONFIG", "~/.config/owlook/config.yml"))
STATE_PATH = File.join(ENV.fetch("XDG_RUNTIME_DIR", "/tmp"), "owlook.json")
CI_POLL_INTERVAL = Integer(ENV.fetch("OWLOOK_POLL_INTERVAL", "30"))
# A queue check is a real SSH round-trip (kamal app exec --reuse), not a free
# API call — needs its own, slower cadence. 60s is a starting estimate, not
# measured against a real server yet; tune with this env var.
QUEUE_POLL_INTERVAL = Integer(ENV.fetch("OWLOOK_QUEUE_POLL_INTERVAL", "60"))

def log(message)
  warn "[owlook] #{Time.now.iso8601} #{message}"
  $stderr.flush
end

config = Owlook::Config.load(CONFIG_PATH)
client = Owlook::GithubClient.new(token: Owlook::GithubClient.resolve_token)

collector = Owlook::Collector.new(
  config: config,
  store: Owlook::Store.new,
  writer: Owlook::StateWriter.new(STATE_PATH),
  github_source: Owlook::Sources::GitHub.new(client: client),
  logger: method(:log)
)

log("starting: #{config.projects.size} project(s), CI every #{CI_POLL_INTERVAL}s, " \
  "queues every #{QUEUE_POLL_INTERVAL}s -> #{STATE_PATH}")
collector.run(ci_interval: CI_POLL_INTERVAL, queue_interval: QUEUE_POLL_INTERVAL)
